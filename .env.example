# Phase 0/1 local development defaults only.
# Copy this file to .env. Never commit real secrets.

COMPOSE_PROJECT_NAME=gn-system

APP_NAME=GN-System
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gn_system
DB_USERNAME=gn_system
DB_PASSWORD=change-me-for-local-development

REDIS_HOST=redis
REDIS_PORT=6379

# Generated by Laravel during Phase 1. Do not share a production APP_KEY.
APP_KEY=
