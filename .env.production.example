COMPOSE_PROJECT_NAME=gn-system-production
PRODUCTION_ENV_FILE=.env.production

# Immutable images. RELEASE_TAG must be a released version such as v1.0.0.
APP_IMAGE=ghcr.io/moh114514/gn-system-app
WEB_IMAGE=ghcr.io/moh114514/gn-system-web
RELEASE_TAG=v0.0.0
RELEASE_STATE_PATH=/srv/gn-system/production/releases

APP_NAME="GN-System CRM"
APP_ENV=production
APP_DEPLOYMENT_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gncrm.local
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_TIMEZONE=Asia/Shanghai
APP_TIME_TRAVEL_ENABLED=false
APP_IMPERSONATION_ENABLED=false
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gn_system
DB_USERNAME=gn_system
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=production

DINGTALK_ENABLED=false
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

BACKUP_DISK=backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

# Absolute host paths. Create these with deploy/prepare-host.sh before startup.
PRIVATE_DATA_PATH=/srv/gn-system/production/data/private
BACKUP_DATA_PATH=/srv/gn-system/production/data/backups
TLS_CERT_PATH=/srv/gn-system/production/tls/fullchain.pem
TLS_KEY_PATH=/srv/gn-system/production/tls/privkey.pem
OFFSITE_BACKUP_PATH=/mnt/gn-system-offsite
OFFSITE_SYNC_MAX_AGE_MINUTES=90
OFFSITE_BACKUP_MONITOR_ENABLED=true

# Restrict published HTTP/HTTPS ports to a LAN address on the server.
LAN_BIND_ADDRESS=192.168.0.141
HTTP_PORT=80
HTTPS_PORT=443
EXTERNAL_HTTPS_PORT_SUFFIX=
