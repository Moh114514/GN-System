COMPOSE_PROJECT_NAME=gn-system-uat
PRODUCTION_ENV_FILE=.env.uat

# UAT uses the same hardened images as production, but always with an RC tag.
APP_IMAGE=ghcr.io/moh114514/gn-system-app
WEB_IMAGE=ghcr.io/moh114514/gn-system-web
RELEASE_TAG=v0.0.0-rc.1
RELEASE_STATE_PATH=/srv/gn-system/releases

APP_NAME="GN-System CRM UAT"
APP_ENV=production
APP_DEPLOYMENT_ENV=uat
APP_KEY=
APP_DEBUG=false
APP_URL=https://gncrm-uat.local:8443
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_TIMEZONE=Asia/Shanghai
APP_TIME_TRAVEL_ENABLED=true
APP_IMPERSONATION_ENABLED=true
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gn_system_uat
DB_USERNAME=gn_system_uat
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Use only UAT/sandbox notification endpoints. Never copy production credentials here.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=uat

DINGTALK_ENABLED=false
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

BACKUP_DISK=backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

PRIVATE_DATA_PATH=/srv/gn-system/data/private
BACKUP_DATA_PATH=/srv/gn-system/data/backups
TLS_CERT_PATH=/srv/gn-system/tls/uat-fullchain.pem
TLS_KEY_PATH=/srv/gn-system/tls/uat-privkey.pem
OFFSITE_BACKUP_PATH=/mnt/gn-system-offsite
OFFSITE_SYNC_MAX_AGE_MINUTES=90
OFFSITE_BACKUP_MONITOR_ENABLED=false

# UAT shares the production host IP but not its published ports.
LAN_BIND_ADDRESS=192.168.0.141
HTTP_PORT=8080
HTTPS_PORT=8443
EXTERNAL_HTTPS_PORT_SUFFIX=:8443
