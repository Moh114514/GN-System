includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 6

    ignoreErrors:
        # Used by the Livewire single-file component in resources/views.
        -
            identifier: trait.unused
            path: app/Concerns/ProfileValidationRules.php
